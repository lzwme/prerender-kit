{
  "name": "@lzwme/prerender-kit",
  "version": "0.1.1",
  "description": "通用预渲染(SSG)工具包。基于无头浏览器将 SPA 路由渲染为静态 HTML，内置增量预渲染能力，支持 vite / webpack / rollup 插件及 CLI 独立使用。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "prerender-kit": "bin/prerender-kit.js",
    "prkit": "bin/prerender-kit.js"
  },
  "sideEffects": false,
  "files": [
    "bin",
    "dist",
    "!dist/cjs",
    "!dist/esm",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lzwme/prerender-kit.git"
  },
  "homepage": "https://github.com/lzwme/prerender-kit",
  "bugs": {
    "url": "https://github.com/lzwme/prerender-kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "renxia",
    "email": "lzwy0820@qq.com",
    "url": "https://lzw.me"
  },
  "maintainers": [
    {
      "name": "renxia",
      "url": "https://lzw.me"
    }
  ],
  "keywords": [
    "prerender",
    "prerender-kit",
    "ssg",
    "ssg-prerender",
    "static-site-generator",
    "seo",
    "spa",
    "puppeteer",
    "vite-plugin",
    "webpack-plugin",
    "rollup-plugin",
    "sitemap",
    "预渲染",
    "静态化"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json -w",
    "build": "run-s clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "lint": "biome check",
    "fix": "biome check --fix",
    "check:tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cov": "vitest run --coverage",
    "verify": "run-s lint check:tsc test",
    "release": "run-s verify build",
    "version": "standard-version"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "puppeteer": ">=20.0.0",
    "vite": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
